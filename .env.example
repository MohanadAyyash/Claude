# Trigon ERP secrets — copy to .env next to server.js and fill in. Never commit .env.
# Zoho Books OAuth Self Client (api-console.zoho.ae → Self Client → Client Secret tab)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data centre: ae (UAE), sa, com, eu, in, au
ZOHO_DC=ae
# Optional: a refresh token instead of pasting a grant code on the Zoho page
# ZOHO_REFRESH_TOKEN=
# Optional: send daily-check failures to GitHub as an "ops-report" issue for the maintenance agent (see OPS.md).
# Fine-grained token, this repository only, permission "Issues: Read and write" — nothing else.
# GITHUB_REPORT_TOKEN=
# GITHUB_REPORT_REPO=MohanadAyyash/Claude
