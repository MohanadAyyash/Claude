# Trigon ERP secrets — copy to .env next to server.js and fill in. Never commit .env.
# Zoho Books OAuth Self Client (api-console.zoho.ae → Self Client → Client Secret tab)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data centre: ae (UAE), sa, com, eu, in, au
ZOHO_DC=ae
# Optional: a refresh token instead of pasting a grant code on the Zoho page
# ZOHO_REFRESH_TOKEN=
# Optional: send daily-check failures to GitHub as an "ops-report" issue for the maintenance agent (see OPS.md).
# Fine-grained token, this repository only, permission "Issues: Read and write" — nothing else.
# GITHUB_REPORT_TOKEN=
# GITHUB_REPORT_REPO=MohanadAyyash/Claude

# Microsoft 365 (Entra ID): every user links their own Microsoft account and can then "Sign in with Microsoft". Off unless M365_ENABLED=1.
# App registration: single tenant, web redirect URIs .../auth/microsoft/callback AND .../auth/microsoft/login/callback,
# delegated permissions openid profile email offline_access User.Read only. Require MFA for the app with Conditional Access.
M365_ENABLED=0
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=https://erp.trigon.ae/auth/microsoft/callback
M365_SHAREPOINT_SITE_ID=
M365_SHAREPOINT_DRIVE_ID=
# 32 random bytes (base64) that encrypt the Microsoft tokens in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it only here (not in backups). If it is lost or changed, disconnect and connect again.
M365_ENCRYPTION_KEY=

# Sign-in mode (see M365.md, "Microsoft-first authentication"):
#   hybrid           password form + "Sign in with Microsoft" (default)
#   microsoft-first  "Sign in with Microsoft" only; the password form is off for everyone. Takes effect only when Microsoft 365 is
#                    enabled + configured AND at least one account below is a valid emergency administrator; otherwise stays hybrid.
AUTH_MODE=hybrid
# Emergency (break-glass) administrators, by username, comma-separated: local admin accounts with ERP two-step sign-in on and NOT linked to
# Microsoft. They sign in at /auth/emergency with password + ERP code (works without Microsoft or the internet). Usernames only, no secrets.
AUTH_EMERGENCY_ADMINS=
# Session lengths, counted from sign-in, never extended by use. Not a positive number → the default; too large → the maximum.
# Emergency sessions: minutes, default 60, 5–240. Microsoft sessions: hours, default 12, 1–720 (password sessions stay 30 days).
AUTH_EMERGENCY_SESSION_MINUTES=60
AUTH_MICROSOFT_SESSION_HOURS=12

# Microsoft 365 business integration (all off by default; see M365.md "Microsoft 365 business integration")
# SharePoint copies of ERP documents (application permission Sites.Selected + a write grant on this one site)
M365_SHAREPOINT_ENABLED=0
M365_SHAREPOINT_ROOT=Trigon Civil Projects
# Automatic saving (on whenever SharePoint is configured): issued / approved documents and staff attachments go by themselves,
# with a retry queue. M365_SHAREPOINT_AUTO=0 switches it off; M365_SHAREPOINT_ATTACHMENTS=0 leaves attachments out;
# M365_SHAREPOINT_AUTO_FROM=2026-01-01 leaves older records out of the automatic saving.
#M365_SHAREPOINT_AUTO=0
#M365_SHAREPOINT_ATTACHMENTS=0
#M365_SHAREPOINT_AUTO_FROM=
# TESTING ONLY (never in production): TRIGON_M365_FAULT=sharepoint makes every SharePoint upload fail like HTTP 503,
# to test the retry queue. Loud warning at startup, in Settings and on the dashboard while set. See M365.md.
#TRIGON_M365_FAULT=sharepoint
# Outlook: users send from their own mailbox (delegated Mail.Send; each user reconnects once)
M365_OUTLOOK_ENABLED=0
# Teams channel webhook (Teams Workflows). The URL carries a signature: keep it only here. Amounts hidden unless allowed.
M365_TEAMS_WEBHOOK_URL=
M365_TEAMS_INCLUDE_AMOUNTS=0

# Read-only Copilot (disabled unless COPILOT_ENABLED=1 and a user ID or role is allowlisted).
# Do not enable against production or connect a provider until the open decisions in docs/COPILOT.md are approved.
COPILOT_ENABLED=0
COPILOT_ALLOWED_USERS=
COPILOT_ALLOWED_ROLES=
COPILOT_MAX_RESULTS=50
COPILOT_USER_LIMIT=20
COPILOT_GLOBAL_LIMIT=200
COPILOT_TIMEOUT_MS=30000
COPILOT_HISTORY_RETENTION_DAYS=90
COPILOT_PERSONALIZATION_ENABLED=1
COPILOT_PROVIDER=azure-openai
COPILOT_AZURE_ENDPOINT=
COPILOT_AZURE_DEPLOYMENT=
COPILOT_AZURE_API_VERSION=
COPILOT_AZURE_API_KEY=
# Optional Microsoft Foundry Models v1 chat-completions adapter; only deployed models supporting this API.
COPILOT_FOUNDRY_ENDPOINT=
COPILOT_FOUNDRY_MODEL=
COPILOT_FOUNDRY_API_KEY=
# Separate optional Entra access-token path; never reuse M365_CLIENT_ID as its API audience.
COPILOT_ENTRA_ENABLED=0
COPILOT_ENTRA_TENANT_ID=
COPILOT_ENTRA_API_AUDIENCE=
# Optional, reviewed identity-provider overrides. Loopback HTTP is allowed only for local tests.
#COPILOT_ENTRA_ISSUER=
#COPILOT_ENTRA_JWKS_URL=
